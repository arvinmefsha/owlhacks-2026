# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored; never commit it or paste its contents anywhere public.
# Only the FastAPI server in api/ reads these. The browser never sees them.

# Google Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Flash model used for per-dive feedback
GEMINI_MODEL=gemini-3.8-flash

# Tiger Data (TimescaleDB) connection string, from the Tiger Cloud console
DATABASE_URL=postgres://tsdbadmin:your-password@your-service-id.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# Optional: Presage SmartSpectra key for the pre-dive readiness check
PRESAGE_API_KEY=
