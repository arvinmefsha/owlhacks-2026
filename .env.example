# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored; never commit it or paste its contents anywhere public.
# Only the FastAPI server in api/ reads these. The browser never sees them.

# Google Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Flash model used for per-dive feedback
GEMINI_MODEL=gemini-3.8-flash

# Required TigerData (TimescaleDB) connection string, from the Tiger Cloud console.
# The API will not start without this URL and a successful database connection.
DATABASE_URL=postgres://tsdbadmin:your-password@your-service-id.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# Optional: Presage SmartSpectra key for the pre-dive readiness check
PRESAGE_API_KEY=

# Optional YOLO inference overrides. Leave YOLO_DEVICE blank for automatic selection.
YOLO_DETECTOR_MODEL=yolo11n.pt
YOLO_POSE_MODEL=yolo11m-pose.pt
YOLO_DEVICE=

# Optional: ElevenLabs key for spoken live-session tips. Blank uses the browser's built-in voice.
ELEVENLABS_API_KEY=
# ElevenLabs voice ID to speak with; needed together with the key
ELEVENLABS_VOICE_ID=
# ElevenLabs model; blank uses eleven_flash_v2_5 (lowest latency)
ELEVENLABS_MODEL=

# Live-session pose model and input size in pixels; blank uses yolo11n-pose.pt at 480
LIVE_POSE_MODEL=
LIVE_POSE_SIZE=
