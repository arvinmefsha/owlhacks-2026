# Secrets: real env files are never committed, only the .env.example templates
.env
.env.*
*.local
!.env.example

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# OS and editors
.DS_Store
.idea/

# Dive footage can show real people, so recordings stay on the machine that made them
recordings/
api/uploads/
api/local-data/
samples/**/*.mp4
samples/**/*.mov
samples/**/*.webm
# Local YOLO weights are downloaded on first use
api/*.pt
